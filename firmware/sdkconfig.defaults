# T003/T002: Baseline sdkconfig defaults for the JC4827W543 (ESP32-S3-WROOM-1-N4R8).
# Run `idf.py set-target esp32s3` once, then `idf.py menuconfig` to review/tune
# board_config peripheral GPIOs (Pop Roaster Board Configuration menu).

CONFIG_IDF_TARGET="esp32s3"

# Octal PSRAM (8MB) present on the N4R8 module - required for LVGL draw buffers.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# Custom partition table with OTA A/B scheme (see partitions.csv).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# N4R8 module has 4MB flash; partitions.csv (OTA A/B + storage) needs the full 4MB.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"


# App rollback support: new firmware must call esp_ota_mark_app_valid_cancel_rollback()
# after self-checking, otherwise the bootloader reverts to the previous OTA slot
# on the next boot (backs FR-015's "keep current partition on failure" behavior).
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

CONFIG_FREERTOS_HZ=1000

# T041: WebSocket support for the live web dashboard telemetry stream
# (firmware/components/web_api/dashboard_routes.c).
CONFIG_HTTPD_WS_SUPPORT=y

# T-nav_shell: montserrat_12 for the narrow sidebar's Emergency Stop button
# label (montserrat_14, the default, overflows the 76px-wide button).
CONFIG_LV_FONT_MONTSERRAT_12=y

# esp_timer's single shared dispatch task runs EVERY periodic callback in
# this firmware (telemetry sampling, profile curve follower, session
# snapshot, duration/fan watchdogs, and the web dashboard's WS broadcaster) -
# the IDF default (3584 bytes) overflowed once the WS broadcaster needed a
# ~1.3KB JSON buffer, crashing/rebooting the board. Bumped for headroom.
CONFIG_ESP_TIMER_TASK_STACK_SIZE=6144

# Diagnostics web page (web_api/diagnostics_routes.c) lists every FreeRTOS
# task's stack high-water-mark usage via uxTaskGetSystemState(), which
# requires the trace facility.
CONFIG_FREERTOS_USE_TRACE_FACILITY=y

# Web dashboard tabs each hold a long-lived WebSocket socket open - default
# of 10 got tight once combined with the httpd server's own socket use
# (see web_api/server.c's max_open_sockets=10 + lru_purge_enable).
CONFIG_LWIP_MAX_SOCKETS=16

# Safety hardening (2026-07-31, ahead of removing the physical bimetallic
# thermal protector): every periodic esp_timer callback in this firmware -
# including the SSR PWM window and the safety manager's own 240C absolute-
# cutoff temperature check - runs on ONE shared esp_timer task. If that task
# ever hung (bug in any callback), the SSR GPIO would freeze at its last
# state AND the cutoff would simply stop being checked, with nothing left
# to catch it once the physical thermostat is gone. profile_curve_follower.c
# now subscribes that task to the Task Watchdog and resets it every control
# tick; PANIC (disabled by default) must be on for a real hang to actually
# reboot the board (safe: GPIOs default OFF at boot) instead of just logging
# a warning and hanging forever.
CONFIG_ESP_TASK_WDT_PANIC=y

# Crash fix (2026-08-07): the default 32KB LVGL object-memory pool was too
# small for the profile editor screen with a real-world 5-segment profile
# (each heating segment builds ~24 LVGL objects: card+2 rows+title+delete
# button+3 steppers of 6 objects each) - decoded the crash backtrace
# (addr2line against build/pop_roaster.elf) straight to
# lv_obj_class_init_obj() -> lv_obj_mark_layout_as_dirty() dereferencing a
# NULL `obj` inside lv_label_create() while building the mandatory trailing
# Cooling segment's "Fixed: ..." label - i.e. lv_mem_alloc() silently
# returned NULL (pool exhausted) and LVGL 8's allocator doesn't null-check
# before use. Tripled to give real headroom for larger profiles too (up to
# the 20-segment max).
CONFIG_LV_MEM_SIZE_KILOBYTES=96
